# ===========================================
# SCANANDGO - ENVIRONMENT CONFIGURATION
# ===========================================
# This file contains all necessary environment variables for the ScanAndGo application

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# MariaDB/MySQL Database Connection
# Format: mysql://username:password@host:port/database_name?connection_limit=10&pool_timeout=20&connect_timeout=10
# Connection pool parameters prevent 504 errors and connection exhaustion:
# - connection_limit: Maximum number of connections in pool (default: 10)
# - pool_timeout: Seconds to wait for available connection (default: 20)
# - connect_timeout: Seconds to wait for initial connection (default: 10)
DATABASE_URL="mysql://root@localhost:3306/scanandgo_prod?connection_limit=10&pool_timeout=20&connect_timeout=10"

# Alternative database configuration (if needed)
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="scanandgo_prod"
DB_USER="root"
DB_PASSWORD=""

# ===========================================
# NEXT.JS CONFIGURATION
# ===========================================
# Next.js environment
NODE_ENV="development"

# Next.js URL (for production, change to your domain)
NEXTAUTH_URL="http://localhost:3000"

# ===========================================
# NEXT-AUTH CONFIGURATION
# ===========================================
# NextAuth.js secret key (REQUIRED for production)
NEXTAUTH_SECRET="qMNz0XN8Mv3iThVE0q2lBL3VviFPydWaSD/oNgpxcZg="

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================
# Application name and version
APP_NAME="ScanAndGo"
APP_VERSION="0.1.0"

# Default admin user (created during database initialization)
DEFAULT_ADMIN_EMAIL="admin@scanandgo.com"
DEFAULT_ADMIN_PASSWORD="admin123"

# ===========================================
# SECURITY CONFIGURATION
# ===========================================
# Session configuration
SESSION_MAX_AGE="43200"  # 12 hours in seconds

# Password hashing rounds (higher = more secure but slower)
BCRYPT_ROUNDS="12"

# ===========================================
# DEVELOPMENT CONFIGURATION
# ===========================================
# Enable debug logging
DEBUG="false"

# Enable database query logging
PRISMA_DEBUG="false"
